{
  "multipart": [
    {
      "when": { "facing": "north" },
      "apply": { "model": "woodworks:shelf_parts/shelf_display_chained" }
    },
    {
      "when": { "facing": "south" },
      "apply": { "model": "woodworks:shelf_parts/shelf_display_chained", "y": 180 }
    },
    {
      "when": { "facing": "east" },
      "apply": { "model": "woodworks:shelf_parts/shelf_display_chained", "y": 90 }
    },
    {
      "when": { "facing": "west" },
      "apply": { "model": "woodworks:shelf_parts/shelf_display_chained", "y": 270 }
    },
    {
      "when": { "facing": "north", "has_left": true },
      "apply": { "model": "woodworks:shelf_parts/shelf_left_display_chained", "uvlock": true }
    },
    {
      "when": { "facing": "north", "has_right": true },
      "apply": { "model": "woodworks:shelf_parts/shelf_right_display_chained", "uvlock": true }
    },
    {
      "when": { "facing": "south", "has_left": true },
      "apply": { "model": "woodworks:shelf_parts/shelf_left_display_chained", "y": 180, "uvlock": true }
    },
    {
      "when": { "facing": "south", "has_right": true },
      "apply": { "model": "woodworks:shelf_parts/shelf_right_display_chained", "y": 180, "uvlock": true }
    },
    {
      "when": { "facing": "east", "has_left": true },
      "apply": { "model": "woodworks:shelf_parts/shelf_left_display_chained", "y": 90, "uvlock": true }
    },
    {
      "when": { "facing": "east", "has_right": true },
      "apply": { "model": "woodworks:shelf_parts/shelf_right_display_chained", "y": 90, "uvlock": true }
    },
    {
      "when": { "facing": "west", "has_left": true },
      "apply": { "model": "woodworks:shelf_parts/shelf_left_display_chained", "y": 270, "uvlock": true }
    },
    {
      "when": { "facing": "west", "has_right": true },
      "apply": { "model": "woodworks:shelf_parts/shelf_right_display_chained", "y": 270, "uvlock": true }
    }
  ]
}
